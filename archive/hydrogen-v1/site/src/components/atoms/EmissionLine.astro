---
/**
 * EmissionLine — 一条发射谱线。
 *
 * 光谱条上的每个分类就是这么一条线。位置由波长决定（短波在左），
 * 颜色是那个波长的真实颜色，高度可以按文章数变化 —— 这对应真实光谱里
 * 谱线强度反映跃迁概率，所以「这个分类写得多」和「这条线更亮更高」
 * 在物理上是同一件事。
 */
import type { Category } from '../../lib/spectrum.ts';
import { formatTransition, formatWavelength, spectrumPosition } from '../../lib/spectrum.ts';

interface Props {
  category: Category;
  /** 相对强度 0..1，映射到线的高度和不透明度。 */
  intensity?: number;
  /** 是否显示波长刻度标签。 */
  showLabel?: boolean;
  class?: string;
}

const { category, intensity = 1, showLabel = false, class: className = '' } = Astro.props;

const position = spectrumPosition(category) * 100;
// 强度下限设 0.32，否则一篇文章都没有的分类会完全看不见、无法点击。
const height = 32 + Math.max(0.32, intensity) * 68;
const opacity = 0.5 + Math.max(0.32, intensity) * 0.5;

const title = `${category.line} ${formatTransition(category)} ${formatWavelength(
  category.airWavelengthNm
)}${category.visible ? '' : '（红外，伪彩色）'}`;
---

<div
  class:list={['emission-slot', className]}
  style={`left: ${position}%; --line-colour: ${category.lineHex};`}
  title={title}
>
  <div
    class="emission-line"
    style={`height: ${height}%; opacity: ${opacity};`}
    aria-hidden="true"
  >
  </div>
  {
    showLabel && (
      <span class="emission-label">
        {category.line}
        <span class="emission-label-nm">{category.airWavelengthNm.toFixed(0)}</span>
      </span>
    )
  }
</div>

<style>
  .emission-slot {
    position: absolute;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    transform: translateX(-50%);
  }

  .emission-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.0625rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
    white-space: nowrap;
  }

  .emission-label-nm {
    font-size: 0.5625rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
</style>
