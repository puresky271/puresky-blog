---
/**
 * ShellBadge — 能级标记。显示壳层字母 + 主量子数。
 *
 * 束缚能作为 title 出现，不占版面：它对大多数读者是背景信息，
 * 但对想知道「这个层级凭什么叫核心」的人是可核对的依据。
 */
import type { Shell } from '../../lib/shells.ts';
import { formatBindingEnergy } from '../../lib/shells.ts';
import { shellPath } from '../../lib/format.ts';

interface Props {
  shell: Shell;
  link?: boolean;
  /** 同时显示层级名称（基态 / 主线 …）。 */
  showTitle?: boolean;
  class?: string;
}

const { shell, link = true, showTitle = false, class: className = '' } = Astro.props;

const Tag = link ? 'a' : 'span';
const title = `${shell.letter} 壳，n=${shell.n}，束缚能 ${formatBindingEnergy(shell.bindingEnergyEv)}`;
---

<Tag
  class:list={['shell-badge', className]}
  title={title}
  {...link ? { href: shellPath(shell.n) } : {}}
>
  <span class="shell-badge-letter">{shell.letter}</span>
  <span class="shell-badge-n">n={shell.n}</span>
  {showTitle && <span class="shell-badge-title">{shell.title}</span>}
</Tag>

<style>
  .shell-badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    transition: color 160ms var(--ease-relax);
  }

  a.shell-badge:hover {
    color: var(--ink-dim);
  }

  .shell-badge-letter {
    display: inline-grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 3px;
    font-size: 0.625rem;
    color: var(--ink-dim);
  }

  .shell-badge-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0;
  }
</style>
