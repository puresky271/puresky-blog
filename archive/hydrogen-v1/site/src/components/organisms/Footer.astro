---
/**
 * Footer — 页脚。
 *
 * 不放版本号、不放构建号、不放城市和天气。页脚的职责是导航兜底
 * 加上一条 RSS 和一条许可说明。
 */
import { NAV_LINKS, SITE, SOCIAL_LINKS } from '../../consts.ts';
import { withBase } from '../../lib/format.ts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer-inner">
    <div class="footer-brand">
      <p class="footer-title">{SITE.title}</p>
      <p class="footer-desc">{SITE.description}</p>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={withBase(link.href.replace(/^\//, ''))}>{link.label}</a>
            </li>
          ))
        }
        <li><a href={withBase('archive/')}>归档</a></li>
        <li><a href={withBase('rss.xml')}>RSS</a></li>
      </ul>
    </nav>

    <div class="footer-social">
      <ul>
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a href={link.href} rel="me noopener" target="_blank">
                {link.label}
                <span class="footer-handle">{link.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="shell footer-legal">
    <p>© {year} {SITE.author}</p>
    <p>文章采用 CC BY-NC-SA 4.0，代码片段采用 MIT。</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    border-top: 1px solid var(--hairline);
    background: var(--surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: 3rem 2rem;
  }

  .footer-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .footer-desc {
    margin: 0.5rem 0 0;
    max-width: 42ch;
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--ink-dim);
  }

  .footer-basis {
    margin: 1rem 0 0;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .footer-num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .footer-nav ul,
  .footer-social ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-nav a,
  .footer-social a {
    font-size: 0.8125rem;
    color: var(--ink-dim);
    transition: color 160ms var(--ease-relax);
  }

  .footer-nav a:hover,
  .footer-social a:hover {
    color: var(--accent-ink);
  }

  .footer-social a {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .footer-handle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-faint);
  }

  .footer-legal {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.125rem;
    border-top: 1px solid var(--hairline);
  }

  .footer-legal p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-faint);
  }

  @media (max-width: 860px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-legal {
      flex-direction: column;
      gap: 0.375rem;
    }
  }
</style>
