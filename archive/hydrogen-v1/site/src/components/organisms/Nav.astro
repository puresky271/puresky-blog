---
/**
 * Nav — 顶栏。
 *
 * 约束：桌面端必须单行、高度不超过 80px。导航项 7 个，
 * 在 lg 断点以下折叠成抽屉，不做两行导航。
 */
import { NAV_LINKS, SITE } from '../../consts.ts';
import { withBase } from '../../lib/format.ts';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  const full = withBase(href.replace(/^\//, ''));
  if (full === withBase('')) return currentPath === full;
  return currentPath.startsWith(full);
}
---

<a class="skip-link" href="#main">跳到正文</a>

<nav class="nav" aria-label="主导航">
  <div class="shell nav-inner">
    <a class="nav-brand" href={withBase('')} aria-label={`${SITE.title} 首页`}>
      <span class="nav-symbol" aria-hidden="true">
        <span class="nav-symbol-z">{SITE.atomicNumber}</span>
        <span class="nav-symbol-h">{SITE.symbol}</span>
      </span>
      <span class="nav-brand-text">
        <span class="nav-brand-name">{SITE.title}</span>
        <span class="nav-brand-theme">{SITE.theme}</span>
      </span>
    </a>

    <ul class="nav-links">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={withBase(link.href.replace(/^\//, ''))}
              class:list={['nav-link', { 'nav-link-active': isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
              data-astro-prefetch="hover"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      <a class="nav-icon-btn" href={withBase('search/')} aria-label="搜索">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.75" cy="8.75" r="5.25" stroke="currentColor" stroke-width="1.5" />
          <path d="m12.75 12.75 3.75 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </a>

      <button class="nav-icon-btn" type="button" data-theme-toggle aria-label="切换配色主题">
        <!-- 暗主题显示实心圆（电子云被照亮），亮主题显示空心圆环。 -->
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.5" class="toggle-core" />
          <circle cx="10" cy="10" r="7.75" stroke="currentColor" stroke-width="1.25" class="toggle-shell" />
        </svg>
      </button>

      <button
        class="nav-icon-btn nav-drawer-btn"
        type="button"
        data-drawer-toggle
        aria-label="打开导航"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 移动端抽屉。默认 hidden，JS 不可用时导航仍可通过页脚访问。 -->
  <div class="nav-drawer" id="nav-drawer" hidden>
    <ul>
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={withBase(link.href.replace(/^\//, ''))}
              class:list={['nav-drawer-link', { 'nav-link-active': isActive(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={withBase('search/')} class="nav-drawer-link">搜索</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in oklab, var(--void) 82%, transparent);
    backdrop-filter: blur(14px) saturate(150%);
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav {
      background: var(--void);
      backdrop-filter: none;
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 64px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: none;
  }

  /*
   * 元素方格：左上角原子序数、中间元素符号。照周期表的排版来，
   * 不是随便找个字母套个方框。
   */
  .nav-symbol {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 5px;
    background: var(--surface);
  }

  .nav-symbol-z {
    position: absolute;
    top: 1px;
    left: 3px;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    line-height: 1;
    color: var(--ink-faint);
  }

  .nav-symbol-h {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1;
    color: var(--accent-ink);
  }

  .nav-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .nav-brand-name {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
  }

  .nav-brand-theme {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-orbit);
    font-size: 0.8125rem;
    color: var(--ink-dim);
    white-space: nowrap;
    transition:
      color 160ms var(--ease-relax),
      background-color 160ms var(--ease-relax);
  }

  .nav-link:hover {
    color: var(--ink);
    background: var(--wash);
  }

  .nav-link-active {
    color: var(--ink);
    background: var(--wash-strong);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }

  .nav-icon-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-orbit);
    color: var(--ink-dim);
    transition:
      color 160ms var(--ease-relax),
      background-color 160ms var(--ease-relax);
  }

  .nav-icon-btn:hover {
    color: var(--ink);
    background: var(--wash);
  }

  .nav-icon-btn svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* 暗主题下核心是实心的，亮主题下变空心。对应「照亮 / 未照亮」。 */
  .toggle-core {
    fill: currentColor;
    transition: fill-opacity 200ms var(--ease-relax);
    fill-opacity: 1;
  }

  :global([data-theme='light']) .toggle-core {
    fill-opacity: 0;
  }

  .toggle-shell {
    opacity: 0.45;
  }

  .nav-drawer-btn {
    display: none;
  }

  .nav-drawer {
    border-top: 1px solid var(--hairline);
    background: var(--surface);
  }

  .nav-drawer ul {
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
  }

  .nav-drawer-link {
    display: block;
    padding: 0.6875rem 1.25rem;
    font-size: 0.9375rem;
    color: var(--ink-dim);
  }

  .nav-drawer-link:hover,
  .nav-drawer-link.nav-link-active {
    color: var(--ink);
    background: var(--wash);
  }

  /* 1080px 以下 7 个导航项开始挤，改用抽屉。 */
  @media (max-width: 1080px) {
    .nav-links {
      display: none;
    }

    .nav-drawer-btn {
      display: grid;
    }
  }
</style>

<script>
  // 抽屉开合。用 hidden 属性而不是 class，保证 JS 失效时抽屉是关着的、
  // 不会在页面顶部堆一坨展开的链接。
  const toggle = document.querySelector<HTMLButtonElement>('[data-drawer-toggle]');
  const drawer = document.getElementById('nav-drawer');

  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const isOpen = !drawer.hidden;
      drawer.hidden = isOpen;
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? '打开导航' : '关闭导航');
    });

    // 视口回到桌面宽度时收起抽屉，避免桌面端同时出现两套导航。
    const wide = window.matchMedia('(min-width: 1081px)');
    wide.addEventListener('change', (event) => {
      if (event.matches) {
        drawer.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
