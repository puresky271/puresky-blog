---
/**
 * projects.astro — 项目页。
 */
import { render } from 'astro:content';

import { allProjects, allPosts } from '../lib/content.ts';
import { postPath } from '../lib/format.ts';

import Page from '../layouts/Page.astro';

const projects = await allProjects();
const posts = await allPosts();

/** 预渲染每个项目的正文，并把 relatedPosts 里的 slug 解析成真实文章。 */
const rendered = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return {
      project,
      Content,
      related: project.data.relatedPosts
        .map((slug) => posts.find((p) => p.id === slug))
        .filter((p): p is (typeof posts)[number] => p !== undefined),
    };
  })
);

const STATUS_LABEL = {
  active: '在做',
  maintained: '维护中',
  paused: '暂停',
  archived: '已归档',
} as const;
---

<Page
  title="项目"
  lede="正在做和做过的东西。每一项都写了它实际解决什么问题，以及现在到哪一步。"
  summary={`${projects.length} 个`}
  width="wide"
>
  {
    rendered.length === 0 ? (
      <div class="state-block">
        <p>还没有登记项目。</p>
      </div>
    ) : (
      <ol class="project-list">
        {rendered.map(({ project, Content, related }, index) => (
          <li class="project" id={project.id}>
            <div class="project-index">{String(index + 1).padStart(2, '0')}</div>

            <div class="project-main">
              <header class="project-header">
                <h2 class="project-name">{project.data.name}</h2>
                <span class:list={['project-status', `is-${project.data.status}`]}>
                  {STATUS_LABEL[project.data.status]}
                </span>
              </header>

              <p class="project-tagline">{project.data.tagline}</p>

              <div class="project-meta">
                <span>自 {project.data.since}</span>
                {project.data.stack.length > 0 && <span>{project.data.stack.join(' · ')}</span>}
              </div>

              <div class="prose prose-hydrogen project-body">
                <Content />
              </div>

              <div class="project-links">
                {
                  project.data.repo && (
                    <a class="btn btn-ghost" href={project.data.repo} rel="noopener" target="_blank">
                      源码
                    </a>
                  )
                }
                {
                  project.data.demo && (
                    <a class="btn btn-ghost" href={project.data.demo} rel="noopener" target="_blank">
                      在线看
                    </a>
                  )
                }
              </div>

              {
                related.length > 0 && (
                  <details class="excite project-related">
                    <summary>
                      <span class="excite-marker" aria-hidden="true" />
                      <span class="project-related-label">
                        写过的 {related.length} 篇
                      </span>
                    </summary>
                    <div class="excite-body">
                      <ul class="project-related-list">
                        {related.map((post) => (
                          <li>
                            <a href={postPath(post.id)}>{post.data.title}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                )
              }
            </div>
          </li>
        ))}
      </ol>
    )
  }
</Page>

<style>
  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 2.75rem;
    border-top: 1px solid var(--hairline);
    scroll-margin-top: 6rem;
  }

  .project:first-child {
    border-top: none;
    padding-top: 0;
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    padding-top: 0.25rem;
  }

  .project-main {
    min-width: 0;
    max-width: 44rem;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
  }

  .project-name {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.018em;
    color: var(--ink);
  }

  .project-status {
    flex: none;
    padding: 0.125rem 0.4375rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-orbit);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  .project-status.is-active {
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    color: var(--accent-ink);
  }

  .project-tagline {
    margin: 0.625rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-dim);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.125rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  .project-body {
    margin-top: 1.5rem;
  }

  /* 项目正文的标题不需要文章页那么大的上边距。 */
  .project-body :global(h3) {
    margin-top: 1.5em;
    font-size: 1rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .project-related {
    margin-top: 1.5rem;
  }

  .project-related-label {
    flex: 1;
    font-size: 0.8125rem;
    color: var(--ink-dim);
  }

  .project-related-list {
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-related-list a {
    font-size: 0.875rem;
    color: var(--ink-dim);
    transition: color 160ms var(--ease-relax);
  }

  .project-related-list a:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 640px) {
    .project {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .project-index {
      padding-top: 0;
    }
  }
</style>
