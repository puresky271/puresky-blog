---
/**
 * ThemeSwitch.astro — 页脚的三段式主题开关：跟随系统 / 亮 / 暗。
 */
import Icon from '@/components/ui/Icon.astro';

const options = [
  { value: 'system', label: '跟随系统', icon: 'monitor' },
  { value: 'light', label: '亮色', icon: 'sun' },
  { value: 'dark', label: '暗色', icon: 'moon' },
] as const;
---

<div class="theme-switch" role="radiogroup" aria-label="主题">
  {
    options.map((o) => (
      <button type="button" role="radio" aria-checked="false" data-theme-pref={o.value} title={o.label}>
        <Icon name={o.icon} size={15} />
        <span class="sr-only">{o.label}</span>
      </button>
    ))
  }
</div>

<style>
  .theme-switch {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  button {
    display: grid;
    place-items: center;
    width: 30px;
    height: 26px;
    border-radius: 999px;
    color: var(--fg-subtle);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }
  button:hover {
    color: var(--fg);
  }
  button[aria-checked='true'] {
    background: var(--surface-3);
    color: var(--fg);
  }
</style>

<script>
  import { getPref, setPref, type ThemePref } from '@/lib/theme';

  function sync() {
    const pref = getPref();
    document.querySelectorAll<HTMLElement>('[data-theme-pref]').forEach((el) => {
      el.setAttribute('aria-checked', String(el.dataset.themePref === pref));
    });
  }

  sync();
  document.addEventListener('astro:page-load', sync);
  window.addEventListener('theme:pref', sync);

  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-theme-pref]');
    if (!button) return;
    const rect = button.getBoundingClientRect();
    setPref(button.dataset.themePref as ThemePref, {
      x: rect.left + rect.width / 2,
      y: rect.top + rect.height / 2,
    });
  });
</script>
