---
/**
 * PostCard.astro — 文章卡片。
 *
 * 有封面时上图下文。没有封面、又是首页「最近的文章」的主卡（size="lg"）时，
 * 不塞假封面，改成一张「导读」卡：大标题、导语、按二级标题列出的本文提纲、字数与阅读时长，
 * 读者点进去之前就知道这篇讲了哪几件事。右上角一团淡淡的主色光和点阵，给卡片一点质感。
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import Icon from '@/components/ui/Icon.astro';
import { categoryOf, postMinutes, postWords, type Post } from '@/lib/content';
import { formatDate, postPath } from '@/lib/format';

interface Props {
  post: Post;
  size?: 'md' | 'lg';
  /** 列表里第几个，用于入场错峰。 */
  index?: number;
}

const { post, size = 'md', index = 0 } = Astro.props;
const { title, description, pubDate, category, cover, coverAlt, featured } = post.data;
const cat = categoryOf(category);

const feature = size === 'lg' && !cover;
// 导读卡的提纲：最多四个二级标题。标题里的锚点符号 # 会被收进文本，去掉。
const outline = feature
  ? (await render(post)).headings
      .filter((h) => h.depth === 2)
      .slice(0, 4)
      .map((h) => h.text.replace(/^#\s*/, '').trim())
  : [];
---

{
  feature ? (
    <article class="card card-link post-card feature group" data-reveal style={`--reveal-i: ${index}`}>
      <a href={postPath(post.id)} class="feature-link">
        <span class="deco" aria-hidden="true" />
        <p class="feature-meta">
          <span class="cat-chip">{cat.label}</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {featured && (
            <span class="pick">
              <Icon name="star-fill" size={12} />
              精选
            </span>
          )}
        </p>
        <h3 class="title">{title}</h3>
        <p class="desc">{description}</p>
        {outline.length > 0 && (
          <ol class="brief" aria-label="本文提纲">
            {outline.map((text, i) => (
              <li>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <span class="t">{text}</span>
              </li>
            ))}
          </ol>
        )}
        <div class="feature-foot">
          <span class="stats">
            <Icon name="clock" size={14} />约 {postMinutes(post)} 分钟
            <span aria-hidden="true">·</span>
            <span class="tabular">{postWords(post).toLocaleString('zh-CN')} 字</span>
          </span>
          <span class="cta">
            阅读全文
            <Icon name="arrow-right" size={15} class="cta-arrow" />
          </span>
        </div>
      </a>
    </article>
  ) : (
    <article class:list={['card card-link post-card group', size]} data-reveal style={`--reveal-i: ${index}`}>
      <a href={postPath(post.id)} class="flex h-full flex-col">
        {cover && (
          <div class="cover">
            <Image src={cover} alt={coverAlt ?? ''} width={size === 'lg' ? 960 : 640} class="h-full w-full object-cover" />
          </div>
        )}
        <div class="body">
          <p class="flex items-center gap-2 text-[0.8125rem] text-fg-muted">
            <span class="text-accent">{cat.label}</span>
            <span aria-hidden="true">·</span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {featured && <Icon name="star-fill" size={13} class="text-accent" label="精选" />}
          </p>
          <h3 class="title">{title}</h3>
          <p class="desc">{description}</p>
          <p class="mt-auto flex items-center gap-1.5 pt-4 text-[0.8125rem] text-fg-subtle">
            <Icon name="clock" size={14} />
            约 {postMinutes(post)} 分钟
          </p>
        </div>
      </a>
    </article>
  )
}

<style>
  .post-card {
    overflow: hidden;
  }
  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .cover :global(img) {
    transition: transform 900ms var(--ease-out-expo);
  }
  .post-card:hover .cover :global(img) {
    transform: scale(1.03);
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.35rem 1.3rem;
  }
  .title {
    margin-top: 0.6rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-wrap: balance;
    transition: color 160ms ease;
  }
  .lg .title {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.6rem);
    line-height: 1.35;
  }
  .post-card:hover .title {
    color: var(--accent);
  }
  .desc {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── 导读卡 ── */
  .feature {
    position: relative;
    isolation: isolate;
  }
  .feature-link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.4rem, 2.6vw, 2rem);
  }
  .deco {
    position: absolute;
    inset: 0 0 auto auto;
    z-index: -1;
    width: 70%;
    height: 75%;
    pointer-events: none;
    background:
      radial-gradient(closest-side at 80% 20%, color-mix(in oklab, var(--accent) 16%, transparent), transparent),
      radial-gradient(circle, color-mix(in oklab, var(--accent) 30%, transparent) 1px, transparent 1.5px) 0 0 / 14px 14px;
    mask-image: radial-gradient(75% 75% at 100% 0%, black, transparent 75%);
    transition: opacity 400ms ease;
    opacity: 0.85;
  }
  .feature:hover .deco {
    opacity: 1;
  }
  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
  .cat-chip {
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    padding-inline: 0.6rem;
    border-radius: 999px;
    font-weight: 500;
    color: var(--accent-strong);
    background: var(--accent-soft);
  }
  .pick {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--accent);
  }
  .feature .title {
    margin-top: 1rem;
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 1.95rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .feature .desc {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.75;
    -webkit-line-clamp: 2;
  }
  /* 提纲。类名不能叫 outline：会撞上 Tailwind 的 outline 工具类，平白多出一圈线框。 */
  .brief {
    display: grid;
    gap: 0.1rem;
    margin-top: 1.25rem;
  }
  .brief li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.32rem 0;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .brief .n {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .brief .t {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .feature-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .stats {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--fg-subtle);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.25rem;
    padding-inline: 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent-fg);
    background: var(--accent);
    transition: background-color 160ms ease;
  }
  .feature:hover .cta {
    background: var(--accent-strong);
  }
  .cta :global(.cta-arrow) {
    transition: transform 300ms var(--ease-out-expo);
  }
  .feature:hover .cta :global(.cta-arrow) {
    transform: translateX(3px);
  }
</style>
