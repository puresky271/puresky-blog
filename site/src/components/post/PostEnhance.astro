---
/**
 * PostEnhance.astro — 正文的渐进增强：代码块的标题栏（语言标签、复制按钮）、分享按钮。
 * 没有 JS 时正文照常可读，这些都是锦上添花。
 */
import { iCheck, iCopy } from '@/lib/icons.generated';

const svg = (icon: { size: number; body: string }) =>
  `<svg width="15" height="15" viewBox="0 0 ${icon.size} ${icon.size}" aria-hidden="true">${icon.body}</svg>`;
---

<template id="code-icons" data-copy={svg(iCopy)} data-check={svg(iCheck)}></template>

<script>
  import { mountAnimations } from '@/components/animation/mount';

  /**
   * 代码块包成一扇「窗」：标题栏（三点 + 语言 + 复制按钮）在上，<pre> 在下。
   * 样式见 prose.css 的 .code-block / .code-head。
   */
  function enhanceCode() {
    const icons = document.getElementById('code-icons') as HTMLTemplateElement | null;
    if (!icons) return;
    document.querySelectorAll<HTMLPreElement>('.prose pre:not([data-enhanced])').forEach((pre) => {
      // 选项卡里的代码块由 .code-tabs 自己提供窗口外框，不再各自包一层。
      if (pre.closest('.code-tabs')) return;
      pre.dataset.enhanced = '';

      const block = document.createElement('div');
      block.className = 'code-block';
      const head = document.createElement('div');
      head.className = 'code-head';
      head.innerHTML = '<span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>';

      const lang = pre.dataset.language;
      const label = document.createElement('span');
      label.className = 'code-lang';
      label.textContent = lang && lang !== 'plaintext' ? lang : 'text';
      head.append(label);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      const idle = `${icons.dataset.copy!}<span>复制</span>`;
      button.innerHTML = idle;
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText ?? pre.innerText;
        try {
          await navigator.clipboard.writeText(code.replace(/\n$/, ''));
          button.innerHTML = `${icons.dataset.check!}<span>已复制</span>`;
          button.dataset.copied = '';
          setTimeout(() => {
            button.innerHTML = idle;
            delete button.dataset.copied;
          }, 1600);
        } catch {
          button.innerHTML = `${icons.dataset.copy!}<span>复制失败</span>`;
        }
      });
      head.append(button);

      pre.replaceWith(block);
      block.append(head, pre);
    });
  }

  /**
   * 多语言选项卡（remark-code-tabs.mjs 的输出）：切换是纯 CSS 的，这里只补一个
   * 「复制当前面板代码」的按钮，放在标签栏右端。
   */
  function enhanceCodeTabs() {
    const icons = document.getElementById('code-icons') as HTMLTemplateElement | null;
    if (!icons) return;
    document.querySelectorAll<HTMLDivElement>('.prose .code-tabs:not([data-enhanced])').forEach((tabs) => {
      tabs.dataset.enhanced = '';
      const bar = tabs.querySelector('.code-tabs-bar');
      if (!bar) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      const idle = `${icons.dataset.copy!}<span>复制</span>`;
      button.innerHTML = idle;
      button.addEventListener('click', async () => {
        const index = [...tabs.querySelectorAll<HTMLInputElement>('.code-tab-radio')].findIndex((radio) => radio.checked);
        const panel = tabs.querySelectorAll('.code-tab-panel')[index];
        const code = panel?.querySelector('code')?.innerText ?? '';
        try {
          await navigator.clipboard.writeText(code.replace(/\n$/, ''));
          button.innerHTML = `${icons.dataset.check!}<span>已复制</span>`;
          button.dataset.copied = '';
          setTimeout(() => {
            button.innerHTML = idle;
            delete button.dataset.copied;
          }, 1600);
        } catch {
          button.innerHTML = `${icons.dataset.copy!}<span>复制失败</span>`;
        }
      });
      bar.append(button);
    });
  }

  /** 分享：支持系统分享面板的设备（主要是手机）用系统面板，否则复制链接。 */
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-share]');
    if (!button) return;
    const url = location.href.split('#')[0];
    const title = document.title;
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      try {
        await navigator.share({ title, url });
        return;
      } catch {
        // 用户取消了分享，不做任何事。
        return;
      }
    }
    const label = button.querySelector('[data-share-label]');
    try {
      await navigator.clipboard.writeText(url);
      if (label) label.textContent = '链接已复制';
    } catch {
      if (label) label.textContent = '复制失败';
    }
    setTimeout(() => {
      if (label) label.textContent = '分享';
    }, 1800);
  });

  enhanceCode();
  enhanceCodeTabs();
  void mountAnimations(document);
  document.addEventListener('astro:page-load', () => {
    enhanceCode();
    enhanceCodeTabs();
    void mountAnimations(document);
  });
</script>
