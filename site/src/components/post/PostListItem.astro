---
/**
 * PostListItem.astro — 列表页的文章卡片：顶部一行左边是日期和阅读量、右边是标签胶囊，
 * 下面是加粗标题和摘要，整卡可点。
 */
import Icon from '@/components/ui/Icon.astro';
import ViewBadge from '@/components/post/ViewBadge.svelte';
import { type Post } from '@/lib/content';
import { formatDateISO, postPath } from '@/lib/format';

interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { title, description, pubDate, tags, featured } = post.data;
---

<li data-reveal style={`--reveal-i: ${Math.min(index, 6)}`}>
  <a href={postPath(post.id)} class="item group">
    <div class="item-head">
      <p class="meta">
        <time datetime={pubDate.toISOString()} class="tabular">{formatDateISO(pubDate)}</time>
        <ViewBadge slug={post.id} client:idle />
      </p>
      <div class="tags" aria-label="标签">
        {tags.slice(0, 5).map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
    <h2 class="title">
      {featured && <Icon name="star-fill" size={14} class="mr-1.5 inline -translate-y-px text-accent" label="精选" />}
      {title}
    </h2>
    <p class="desc">{description}</p>
  </a>
</li>

<style>
  .item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--radius-card);
    transition: border-color 180ms ease, background-color 180ms ease, transform 180ms var(--ease-out-expo), box-shadow 180ms ease;
  }
  .item:hover {
    background: var(--surface-2);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }
  .item-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }
  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-subtle);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    margin-left: auto;
  }
  .tag {
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--fg-muted);
    font-size: 0.72rem;
    line-height: 1.25;
  }
  .title {
    margin: 0;
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--fg);
    transition: color 160ms ease;
  }
  .item:hover .title {
    color: var(--accent);
  }
  .desc {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.8;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
