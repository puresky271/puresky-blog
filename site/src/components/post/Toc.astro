---
/**
 * Toc.astro — 文章目录。
 *
 * 桌面端是左侧粘性的目录卡片，自动编号（1 / 1.1），当前阅读到的章节底色和左侧竖条一起亮起；
 * 移动端是正文上方的折叠块。只收 h2 / h3，再深的层级在目录里只会制造噪音。
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'sidebar' | 'inline';
}

const { headings, variant } = Astro.props;
// 标题里的锚点符号 # 会被收进 heading 文本，去掉。
const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, text: h.text.replace(/^#\s*/, '').trim() }));
---

{
  items.length >= 2 &&
    (variant === 'sidebar' ? (
      <nav class="toc-sidebar" aria-label="文章目录" data-toc>
        <p class="toc-head">
          <span>本页目录</span>
          <span class="toc-count">{items.filter((h) => h.depth === 2).length} 节</span>
        </p>
        <ol class="toc-list">
          {items.map((h) => (
            <li class:list={[`depth-${h.depth}`]}>
              <a href={`#${h.slug}`} data-toc-link={h.slug}>
                <span class="num" aria-hidden="true" />
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
        <a href="#main" class="to-top">
          回到顶部 ↑
        </a>
      </nav>
    ) : (
      <details class="toc-inline">
        <summary>目录 · {items.length} 节</summary>
        <ol class="toc-list">
          {items.map((h) => (
            <li class:list={[`depth-${h.depth}`]}>
              <a href={`#${h.slug}`}>
                <span class="num" aria-hidden="true" />
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    ))
}

<style>
  /* ── 桌面：左侧目录卡片 ── */
  .toc-sidebar {
    position: sticky;
    top: calc(var(--nav-h) + 1.25rem);
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - var(--nav-h) - 2.5rem);
    padding: 0.9rem 0.5rem 0.75rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: color-mix(in oklab, var(--surface) 70%, transparent);
  }
  .toc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0 0.6rem 0.65rem 0.35rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--fg);
  }
  .toc-count {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--fg-subtle);
  }
  .toc-sidebar .toc-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.25rem;
  }

  /* 自动编号：二级 1 2 3，三级 1.1 1.2。列表是扁平的，计数器靠兄弟元素作用域传下去。 */
  .toc-list {
    counter-reset: h2;
  }
  .toc-list .depth-2 {
    counter-increment: h2;
    counter-reset: h3;
  }
  .toc-list .depth-3 {
    counter-increment: h3;
  }
  .toc-list .depth-2 .num::before {
    content: counter(h2) '.';
  }
  .toc-list .depth-3 .num::before {
    content: counter(h2) '.' counter(h3);
  }
  .num {
    flex-shrink: 0;
    min-width: 1.4em;
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--fg-subtle);
    transition: color 160ms ease;
  }
  .depth-3 .num {
    min-width: 2.1em;
  }

  .toc-list a {
    position: relative;
    display: flex;
    gap: 0.35rem;
    padding: 0.36rem 0.5rem 0.36rem 0.6rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fg-muted);
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }
  .toc-list .depth-3 a {
    padding-left: 1.35rem;
    font-size: 0.78rem;
  }
  .toc-list a:hover {
    color: var(--fg);
    background: var(--surface-2);
  }
  /* 当前章节：浅主色底 + 左侧一截竖条。 */
  .toc-list a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    bottom: 0.45rem;
    width: 2.5px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 240ms var(--ease-out-expo);
  }
  .toc-list a[aria-current='true'] {
    color: var(--accent-strong);
    background: color-mix(in oklab, var(--accent) 9%, transparent);
  }
  .toc-list a[aria-current='true'] .num {
    color: var(--accent);
  }
  .toc-list a[aria-current='true']::before {
    transform: scaleY(1);
  }
  .to-top {
    align-self: flex-start;
    margin: 0.6rem 0 0 0.35rem;
    font-size: 0.75rem;
    color: var(--fg-subtle);
    transition: color 160ms ease;
  }
  .to-top:hover {
    color: var(--accent);
  }

  /* ── 移动：正文上方的折叠块 ── */
  .toc-inline {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    font-size: 0.875rem;
  }
  .toc-inline summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }
  .toc-inline summary::-webkit-details-marker {
    display: none;
  }
  .toc-inline summary::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 1.5px solid var(--fg-subtle);
    border-bottom: 1.5px solid var(--fg-subtle);
    rotate: 45deg;
    translate: 0 -0.15em;
    transition: rotate 200ms var(--ease-out-expo);
  }
  .toc-inline[open] summary::after {
    rotate: 225deg;
    translate: 0 0.1em;
  }
  .toc-inline .toc-list {
    padding: 0 0.5rem 0.6rem;
  }
</style>

<script>
  /*
   * 当前章节高亮：观察每个标题，取「已经滚过视口上方 30% 线」的最后一个。
   * 用 IntersectionObserver 记录标题的进出，不监听 scroll。
   */
  let observer: IntersectionObserver | null = null;

  function setupToc() {
    observer?.disconnect();
    const toc = document.querySelector('[data-toc]');
    if (!toc) return;
    const links = new Map<string, HTMLElement>();
    toc.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));
    const above = new Set<string>();

    const update = () => {
      const current = headings.filter((h) => above.has(h.id)).pop() ?? headings[0];
      links.forEach((a, id) => a.setAttribute('aria-current', String(id === current?.id)));
    };

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          // 标题在观察区上方（已经读过）时记入集合。
          if (entry.boundingClientRect.top < (entry.rootBounds?.top ?? 0) + 1) above.add(entry.target.id);
          else above.delete(entry.target.id);
        }
        update();
      },
      { rootMargin: '0px 0px -70% 0px', threshold: [0, 1] }
    );
    headings.forEach((h) => observer!.observe(h));
    update();
  }

  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>
