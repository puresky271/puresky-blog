---
/**
 * Toc.astro — 文章目录。
 *
 * 桌面端是左侧粘性的目录卡片，自动编号（1 / 1.1），当前阅读到的章节底色和左侧竖条一起亮起；
 * h3 按 h2 分组收进可折叠容器：当前阅读位置所在的组展开，其余组收起（没有 JS 时全部展开）；
 * 移动端是正文上方的折叠块，只做 h3 缩进。只收 h2 / h3，再深的层级在目录里只会制造噪音。
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'sidebar' | 'inline';
}

const { headings, variant } = Astro.props;
// 标题里的锚点符号 # 会被收进 heading 文本，去掉。
const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, text: h.text.replace(/^#\s*/, '').trim() }));

// 按 h2 分组：每个 h2 一组，组内的 h3 放进可折叠容器。
// 正文开头就是 h3（还没有 h2）时单独收集，照常渲染成缩进项，不丢内容。
type Entry = (typeof items)[number];
interface TocGroup {
  heading: Entry;
  children: Entry[];
}

const groups: TocGroup[] = [];
const loose: Entry[] = [];
let current: TocGroup | null = null;
for (const item of items) {
  if (item.depth === 2) {
    current = { heading: item, children: [] };
    groups.push(current);
  } else if (current) {
    current.children.push(item);
  } else {
    loose.push(item);
  }
}
const sectionCount = items.filter((h) => h.depth === 2).length;
---

{
  items.length >= 2 &&
    (variant === 'sidebar' ? (
      <nav class="toc-sidebar" aria-label="文章目录" data-toc>
        <p class="toc-head">
          <span>本页目录</span>
          <span class="toc-count">{sectionCount} 节</span>
        </p>
        <ol class="toc-list">
          {loose.map((h) => (
            <li class="depth-3">
              <a href={`#${h.slug}`} data-toc-link={h.slug}>
                <span class="num" aria-hidden="true" />
                <span>{h.text}</span>
              </a>
            </li>
          ))}
          {groups.map((g) => (
            <li class="toc-group depth-2" data-toc-group={g.heading.slug}>
              <a class="toc-h2" href={`#${g.heading.slug}`} data-toc-link={g.heading.slug}>
                <span class="num" aria-hidden="true" />
                <span>{g.heading.text}</span>
              </a>
              {g.children.length > 0 && (
                <div class="toc-sub" data-toc-sub>
                  <ol class="toc-sublist">
                    {g.children.map((h) => (
                      <li class="depth-3">
                        <a href={`#${h.slug}`} data-toc-link={h.slug}>
                          <span class="num" aria-hidden="true" />
                          <span>{h.text}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </li>
          ))}
        </ol>
        <a href="#main" class="to-top">
          回到顶部 ↑
        </a>
      </nav>
    ) : (
      <details class="toc-inline">
        <summary>目录 · {items.length} 节</summary>
        <ol class="toc-list">
          {items.map((h) => (
            <li class:list={[`depth-${h.depth}`]}>
              <a href={`#${h.slug}`}>
                <span class="num" aria-hidden="true" />
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    ))
}

<style>
  /* ── 桌面：左侧目录卡片 ── */
  .toc-sidebar {
    position: sticky;
    top: calc(var(--nav-h) + 1.25rem);
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - var(--nav-h) - 2.5rem);
    padding: 0.9rem 0.5rem 0.75rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: color-mix(in oklab, var(--surface) 70%, transparent);
  }
  .toc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0 0.6rem 0.65rem 0.35rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--fg);
  }
  .toc-count {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--fg-subtle);
  }
  .toc-sidebar .toc-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.25rem;
  }

  /* 自动编号：二级 1 2 3，三级 1.1 1.2。h3 缩在组里，计数器靠组的 counter-reset 传下去。 */
  .toc-list {
    counter-reset: h2;
  }
  .toc-list .depth-2 {
    counter-increment: h2;
    counter-reset: h3;
  }
  .toc-list .depth-3 {
    counter-increment: h3;
  }
  .toc-list .depth-2 .num::before {
    content: counter(h2) '.';
  }
  .toc-list .depth-3 .num::before {
    content: counter(h2) '.' counter(h3);
  }
  .num {
    flex-shrink: 0;
    min-width: 1.4em;
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--fg-subtle);
    transition: color 160ms ease;
  }
  .depth-3 .num {
    min-width: 2.1em;
  }

  .toc-list a {
    position: relative;
    display: flex;
    gap: 0.35rem;
    padding: 0.36rem 0.5rem 0.36rem 0.6rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fg-muted);
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }
  .toc-list .depth-3 a {
    padding-left: 1.35rem;
    font-size: 0.78rem;
  }
  .toc-list a:hover {
    color: var(--fg);
    background: var(--surface-2);
  }
  /* 当前章节：浅主色底 + 左侧一截竖条。 */
  .toc-list a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    bottom: 0.45rem;
    width: 2.5px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 240ms var(--ease-out-expo);
  }
  .toc-list a[aria-current='true'] {
    color: var(--accent-strong);
    background: color-mix(in oklab, var(--accent) 9%, transparent);
  }
  .toc-list a[aria-current='true'] .num {
    color: var(--accent);
  }
  .toc-list a[aria-current='true']::before {
    transform: scaleY(1);
  }
  /* 当前读的是组里的 h3：父 h2 只换文字色，不加底色、不留竖条，也不改变布局。 */
  :global(html.js) .toc-group[data-toc-branch] > .toc-h2 {
    color: var(--accent-strong);
  }
  .to-top {
    align-self: flex-start;
    margin: 0.6rem 0 0 0.35rem;
    font-size: 0.75rem;
    color: var(--fg-subtle);
    transition: color 160ms ease;
  }
  .to-top:hover {
    color: var(--accent);
  }

  /* ── 折叠：h3 组随阅读进度展开 / 收起 ── */
  /*
   * 用 grid-template-rows 0fr / 1fr 做高度过渡，内层 overflow: hidden 把内容裁掉。
   * 默认（html 上没有 .js，脚本没跑起来）是 1fr + visible，所有组都展开，不能因为没 JS 就看不到小节。
   */
  .toc-sub {
    display: grid;
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.3s var(--ease-out-expo),
      visibility 0.3s var(--ease-out-expo);
  }
  .toc-sub > .toc-sublist {
    min-height: 0;
    overflow: hidden;
  }
  :global(html.js) .toc-group:not([data-toc-open]) .toc-sub {
    grid-template-rows: 0fr;
    visibility: hidden;
  }
  /* 初始化阶段先关掉过渡：首屏从「全部展开」收成当前组时不带动画。 */
  .toc-sidebar[data-toc-instant] .toc-sub {
    transition: none;
  }

  /* ── 移动：正文上方的折叠块 ── */
  .toc-inline {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    font-size: 0.875rem;
  }
  .toc-inline summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }
  .toc-inline summary::-webkit-details-marker {
    display: none;
  }
  .toc-inline summary::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 1.5px solid var(--fg-subtle);
    border-bottom: 1.5px solid var(--fg-subtle);
    rotate: 45deg;
    translate: 0 -0.15em;
    transition: rotate 200ms var(--ease-out-expo);
  }
  .toc-inline[open] summary::after {
    rotate: 225deg;
    translate: 0 0.1em;
  }
  .toc-inline .toc-list {
    padding: 0 0.5rem 0.6rem;
  }
</style>

<script>
  /*
   * 当前章节高亮 + 按 h2 分组折叠。
   * 用 IntersectionObserver（rootMargin 上方留 30% 的观察区）当主要触发源；
   * 但 IO 只在标题进出观察带时回调，一次滚动或跳转如果停在观察带里一个标题都没有的位置，
   * 它就一声不吭，目录会停在上一节。所以再挂一个 passive scroll 兜底，用 requestAnimationFrame
   * 合并成每帧最多一次 update（update 内部本来就按标题当前位置算，不依赖 entries）。
   * 当前项所在的组展开、其余组收起（0.3s 过渡）；折叠会改变列表高度，
   * 所以只调目录列表容器的 scrollTop 把当前项留在可视区，不用 scrollIntoView 让整页跳。
   */
  let observer: IntersectionObserver | null = null;
  let scrollTimer: number | undefined;
  let scrollAbort: AbortController | null = null;
  let updateFrame = 0;

  /** 把链接挪进目录列表的可视区：只动容器的 scrollTop，页面本身不滚动。 */
  function keepInView(list: HTMLElement, link: HTMLElement, smooth: boolean) {
    const box = list.getBoundingClientRect();
    const rect = link.getBoundingClientRect();
    const pad = 10;
    if (rect.top >= box.top + pad && rect.bottom <= box.bottom - pad) return;
    const delta = rect.top < box.top + pad ? rect.top - box.top - pad : rect.bottom - box.bottom + pad;
    list.scrollTo({ top: list.scrollTop + delta, behavior: smooth ? 'smooth' : 'auto' });
  }

  function setupToc() {
    // 站内跳转后旧 DOM 已经换掉：断开上一页的观察器、摘掉兜底监听、清掉挂起的回调，再重新初始化。
    observer?.disconnect();
    observer = null;
    scrollAbort?.abort();
    scrollAbort = null;
    cancelAnimationFrame(updateFrame);
    updateFrame = 0;
    window.clearTimeout(scrollTimer);

    const toc = document.querySelector<HTMLElement>('[data-toc]');
    if (!toc) return;

    const links = new Map<string, HTMLElement>();
    toc.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));
    const groups = [...toc.querySelectorAll<HTMLElement>('[data-toc-group]')];
    const list = toc.querySelector<HTMLElement>('.toc-list');

    // 初始化阶段关掉折叠过渡：首屏从「全部展开」收成当前组时不带动画。
    let ready = false;
    toc.setAttribute('data-toc-instant', '');
    // 上一次更新时的展开组和当前项，用来判断列表高度 / 位置是否真的变了，避免每帧都去挪 scrollTop。
    let lastGroup: HTMLElement | null = null;
    let lastAnchor: HTMLElement | null = null;

    const update = () => {
      // rootMargin '0px 0px -70% 0px' 把观察区压到视口上方 30%，这条下沿就是「读到这儿」的分界线。
      const line = window.innerHeight * 0.3;
      // 滚过这条线的最后一个标题就是当前章节（页首一个都没滚过时取第一个）。
      const current = headings.filter((h) => h.getBoundingClientRect().top < line).pop() ?? headings[0];
      const id = current?.id;
      links.forEach((a, key) => {
        const value = String(key === id);
        if (a.getAttribute('aria-current') !== value) a.setAttribute('aria-current', value);
      });
      const anchor = current ? links.get(current.id) : undefined;
      const group = anchor?.closest<HTMLElement>('[data-toc-group]') ?? null;
      // 当前项本身是 h3 时，父 h2 也给一层轻量的当前态。
      const inSub = Boolean(anchor?.closest('.toc-sub'));
      for (const g of groups) {
        const isCurrent = g === group;
        g.toggleAttribute('data-toc-open', isCurrent);
        g.toggleAttribute('data-toc-branch', isCurrent && inSub);
      }
      if (!list || !anchor) return;

      const groupChanged = group !== lastGroup;
      const anchorChanged = anchor !== lastAnchor;
      lastGroup = group;
      lastAnchor = anchor;
      if (!groupChanged && !anchorChanged) return;

      if (!ready) {
        // 首屏：直接落位，不做平滑滚动。
        keepInView(list, anchor, false);
        return;
      }
      if (groupChanged) {
        // 等 0.3s 的折叠过渡结束、列表高度稳定后再挪，否则算出来的是旧高度。
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          if (lastAnchor) keepInView(list, lastAnchor, true);
        }, 320);
      } else {
        // 同一组内换小节：列表高度没变，直接平滑挪。
        keepInView(list, anchor, true);
      }
    };

    observer = new IntersectionObserver(
      () => update(),
      { rootMargin: '0px 0px -70% 0px', threshold: [0, 1] }
    );
    headings.forEach((h) => observer!.observe(h));

    // 兜底更新：每帧最多一次，只读位置和切状态，不碰页面布局。
    const abort = new AbortController();
    scrollAbort = abort;
    window.addEventListener(
      'scroll',
      () => {
        if (updateFrame) return;
        updateFrame = requestAnimationFrame(() => {
          updateFrame = 0;
          update();
        });
      },
      { passive: true, signal: abort.signal }
    );

    update();

    // 两帧之后放开过渡，之后的组切换才有 0.3s 动画。
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        toc.removeAttribute('data-toc-instant');
        ready = true;
      });
    });
  }

  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>
