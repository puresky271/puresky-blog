---
/**
 * ProjectCard.astro — 项目卡片。
 *
 * 填了 repo 且这个仓库在 GitHub 快照里时，显示 star、主语言和最近推送时间；
 * 这些数字来自构建期快照，不是手写的。
 */
import type { GitHubRepo } from '@shared/github';

import Icon from '@/components/ui/Icon.astro';
import type { Project } from '@/lib/content';
import { formatCount, formatDate } from '@/lib/format';

interface Props {
  project: Project;
  repo?: GitHubRepo;
  index?: number;
}

const { project, repo, index = 0 } = Astro.props;
const { name, tagline, status, since, stack, demo } = project.data;
const repoUrl = project.data.repo ? `https://github.com/${project.data.repo}` : undefined;

const STATUS = {
  active: '进行中',
  maintained: '维护中',
  paused: '暂停',
  archived: '已归档',
} as const;
---

<article class="card project" data-reveal style={`--reveal-i: ${index}`}>
  <header class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-lg font-semibold tracking-tight text-fg">{name}</h3>
      <p class="mt-1 text-[0.8125rem] text-fg-subtle">
        <span class:list={['status', status]}>{STATUS[status]}</span>
        <span class="mx-1.5" aria-hidden="true">·</span>
        始于 {since}
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-1">
      {
        demo && (
          <a href={demo} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label={`${name} 在线演示`}>
            <Icon name="arrow-square-out" size={17} />
          </a>
        )
      }
      {
        repoUrl && (
          <a href={repoUrl} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label={`${name} 的 GitHub 仓库`}>
            <Icon name="github-logo" size={17} />
          </a>
        )
      }
    </div>
  </header>

  <p class="mt-3 text-[0.9375rem] leading-relaxed text-fg-muted">{tagline}</p>

  {
    stack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {stack.map((item) => (
          <li class="chip !h-6 !text-[0.75rem]">{item}</li>
        ))}
      </ul>
    )
  }

  {
    repo && (
      <p class="repo-line">
        {repo.language && (
          <span class="inline-flex items-center gap-1.5">
            <span class="lang-dot" style={`background: ${repo.languageColor ?? 'var(--fg-subtle)'}`} />
            {repo.language}
          </span>
        )}
        <span class="inline-flex items-center gap-1">
          <Icon name="star" size={14} />
          {formatCount(repo.stars)}
        </span>
        <span class="inline-flex items-center gap-1">
          <Icon name="git-fork" size={14} />
          {formatCount(repo.forks)}
        </span>
        <span class="ml-auto">更新于 {formatDate(repo.pushedAt)}</span>
      </p>
    )
  }
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
  }
  .status.active {
    color: var(--success);
  }
  .status.archived,
  .status.paused {
    color: var(--fg-subtle);
  }
  .repo-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
  .lang-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
  }
</style>
