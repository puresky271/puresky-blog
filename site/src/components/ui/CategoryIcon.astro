---
/**
 * CategoryIcon.astro — 文章题材的方形像素图标。
 *
 * 每个题材一块 80px 直角方章，底色是 global.css 里的 --cat-<题材>，图案用 --cat-ink
 * 画在 16x16 网格上（纯 currentColor 剪影、1px 呼吸位、crispEdges 渲染）。
 * 图案定义抽在 lib/category-art.ts，与可变形方章共用同一份像素画。
 */
import type { CategoryId } from '@/config';
import { CATEGORY_ART, toGlyph } from '@/lib/category-art';

interface Props {
  category: CategoryId;
  /** lg=80px（文章页默认），md=64px（分类页头），sm=44px（总览目录）。 */
  size?: 'sm' | 'md' | 'lg';
}

const { category, size = 'lg' } = Astro.props;

const glyphs = Object.fromEntries(
  Object.entries(CATEGORY_ART).map(([id, art]) => [id, toGlyph(art)])
) as Record<CategoryId, string>;
---

<span class="cat-icon" data-category={category} data-size={size}>
  <svg
    viewBox="0 0 16 16"
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
    set:html={glyphs[category]}
  />
</span>

<style>
  .cat-icon {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    flex: none;
    width: 5rem;
    height: 5rem;
    padding: 0.625rem;
    border-radius: 0;
    color: var(--cat-ink);
  }
  .cat-icon[data-size='md'] {
    width: 4rem;
    height: 4rem;
    padding: 0.5rem;
  }
  .cat-icon[data-size='sm'] {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.35rem;
  }

  /* 底色按题材取令牌，六个题材各一条，别写成 inline style。 */
  .cat-icon[data-category='technology'] {
    background: var(--cat-technology);
  }
  .cat-icon[data-category='algorithms'] {
    background: var(--cat-algorithms);
  }
  .cat-icon[data-category='papers'] {
    background: var(--cat-papers);
  }
  .cat-icon[data-category='curation'] {
    background: var(--cat-curation);
  }
  .cat-icon[data-category='essays'] {
    background: var(--cat-essays);
  }
  .cat-icon[data-category='literature'] {
    background: var(--cat-literature);
  }

  .cat-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
