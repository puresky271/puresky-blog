---
/**
 * CategoryIcon.astro — 文章题材的方形像素图标。
 *
 * 每个题材一块 80px 直角方章，底色是 global.css 里的 --cat-<题材>，图案用 --cat-ink
 * 画在 16x16 网格上（纯 currentColor 剪影、1px 呼吸位、crispEdges 渲染）。
 * 图案以 ASCII 像素画的形式写在 ART 里：'#' 为墨色像素，'.' 为透明。
 * 第一个题材是 technology，六张图互不相似，在 56px 下也能认出来。
 */
import type { CategoryId } from '@/config';

interface Props {
  category: CategoryId;
}

const { category } = Astro.props;

// prettier-ignore
const ART: Record<CategoryId, string[]> = {
  // 技术：终端窗口，标题栏两个窗控点，里面是提示符 > 和光标 _
  technology: [
    '................',
    '................',
    '.##############.',
    '.##.#.#########.',
    '.#............#.',
    '.#............#.',
    '.#..##........#.',
    '.#...##.......#.',
    '.#....##......#.',
    '.#...##.......#.',
    '.#..##...###..#.',
    '.#............#.',
    '.#............#.',
    '.##############.',
    '................',
    '................',
  ],
  // 算法解题：三层二叉树，2x2 实心节点加 1px 连线
  algorithms: [
    '................',
    '................',
    '.......##.......',
    '.......##.......',
    '.......##.......',
    '......#..#......',
    '.....#....#.....',
    '...##......##...',
    '...##......##...',
    '...##......##...',
    '..#..#....#..#..',
    '.#....#..#....#.',
    '.##..##..##..##.',
    '.##..##..##..##.',
    '................',
    '................',
  ],
  // 论文解读：右上折角的文稿，三条正文线和一条短尾线
  papers: [
    '................',
    '................',
    '...#######......',
    '...########.....',
    '...#########....',
    '...##########...',
    '...##########...',
    '...##......##...',
    '...##########...',
    '...##......##...',
    '...##########...',
    '...##......##...',
    '...##########...',
    '...##....####...',
    '................',
    '................',
  ],
  // 精选收录：书签，底部 V 形缺口，中间一颗五角星
  curation: [
    '................',
    '...##########...',
    '...##########...',
    '...##########...',
    '...##########...',
    '...####..####...',
    '...###....###...',
    '...##......##...',
    '...###....###...',
    '...###.##.###...',
    '...##########...',
    '...##########...',
    '...####..####...',
    '...###....###...',
    '...##......##...',
    '................',
  ],
  // 随笔：斜放的铅笔（笔杆 + 笔尖），笔头附近三个墨点
  essays: [
    '................',
    '................',
    '...........####.',
    '..........####..',
    '.........####...',
    '........####....',
    '.......####.....',
    '......####......',
    '.....####.......',
    '....###.........',
    '...##...........',
    '..##............',
    '..#.............',
    '....#.#.#.......',
    '................',
    '................',
  ],
  // 文学创作：摊开的书，左右两页 + 中缝，页内几条线
  literature: [
    '................',
    '................',
    '................',
    '................',
    '.###........###.',
    '.#####....#####.',
    '.######..######.',
    '.######..######.',
    '.#....#..#....#.',
    '.######..######.',
    '.#....#..#....#.',
    '.######..######.',
    '.######..######.',
    '..############..',
    '......####......',
    '................',
  ],
};

/**
 * 把像素画转成一条 SVG path：每行连续的 '#' 合并成一个矩形子路径，
 * 比逐像素生成 rect 省掉大量节点。
 */
function toGlyph(rows: string[]): string {
  const parts: string[] = [];
  rows.forEach((row, y) => {
    for (let x = 0; x < row.length; x += 1) {
      if (row[x] !== '#') continue;
      let w = 1;
      while (row[x + w] === '#') w += 1;
      parts.push(`M${x} ${y}h${w}v1h-${w}z`);
      x += w - 1;
    }
  });
  return `<path d="${parts.join('')}"/>`;
}

const glyphs = Object.fromEntries(Object.entries(ART).map(([id, art]) => [id, toGlyph(art)])) as Record<
  CategoryId,
  string
>;
---

<span class="cat-icon" data-category={category}>
  <svg
    viewBox="0 0 16 16"
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
    set:html={glyphs[category]}
  />
</span>

<style>
  .cat-icon {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    flex: none;
    width: 5rem;
    height: 5rem;
    padding: 0.625rem;
    border-radius: 0;
    color: var(--cat-ink);
  }

  /* 底色按题材取令牌，六个题材各一条，别写成 inline style。 */
  .cat-icon[data-category='technology'] {
    background: var(--cat-technology);
  }
  .cat-icon[data-category='algorithms'] {
    background: var(--cat-algorithms);
  }
  .cat-icon[data-category='papers'] {
    background: var(--cat-papers);
  }
  .cat-icon[data-category='curation'] {
    background: var(--cat-curation);
  }
  .cat-icon[data-category='essays'] {
    background: var(--cat-essays);
  }
  .cat-icon[data-category='literature'] {
    background: var(--cat-literature);
  }

  .cat-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
