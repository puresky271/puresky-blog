---
/**
 * PageHeader.astro — 二级页面的页头：标题、一句说明、可选的附加内容（筛选条之类）。
 */
interface Props {
  title: string;
  description?: string;
  /** 标题旁边的小号计数，例如文章数。 */
  count?: number;
}

const { title, description, count } = Astro.props;
---

<header class="container-page mb-10 md:mb-12">
  <h1 class="flex items-baseline gap-3 text-[clamp(1.875rem,1.5rem+1.4vw,2.5rem)] font-bold leading-tight tracking-tight text-fg">
    {title}
    {count !== undefined && <span class="tabular text-lg font-normal text-fg-subtle">{count}</span>}
  </h1>
  {description && <p class="mt-3 max-w-[40rem] text-[1.0625rem] leading-relaxed text-fg-muted">{description}</p>}
  <slot />
</header>
