---
import { Image } from 'astro:assets';

import Icon from '@/components/ui/Icon.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { AUTHOR, GITHUB } from '@/config';
import Base from '@/layouts/Base.astro';
import { getIllustrations, getPosts, getTags } from '@/lib/content';
import { formatDate, withBase } from '@/lib/format';
import { getGitHubSnapshot } from '@/lib/snapshots';

const [posts, tags, github, illustrations] = await Promise.all([getPosts(), getTags(), getGitHubSnapshot(), getIllustrations()]);
const first = posts.at(-1);

/*
 * 关于页的横幅：优先用本机专用的 src/assets/local/about.*（已 gitignore，不进公开仓库），
 * 没有时（CI 构建、别人 clone）回退到画廊里第一张横版插画。
 */
const localAbout = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/local/about.{png,jpg,jpeg,webp,avif}', { eager: true })
)[0]?.default;
const fallback = illustrations.find((i) => i.data.image.width > i.data.image.height) ?? illustrations[0];
const banner = localAbout
  ? { src: localAbout, alt: '五个女孩并排站在一起的手绘插画', local: true }
  : fallback
    ? { src: fallback.data.image, alt: fallback.data.alt, local: false }
    : null;

const facts = [
  { label: '文章', value: `${posts.length} 篇` },
  { label: '标签', value: `${tags.length} 个` },
  { label: '第一篇', value: first ? formatDate(first.data.pubDate) : '还没有' },
  { label: 'GitHub 贡献', value: github?.calendar ? `过去一年 ${github.calendar.total} 次` : '暂无数据' },
];

const links = [
  { href: `https://github.com/${GITHUB.username}`, label: 'GitHub', icon: 'github-logo', external: true },
  { href: withBase('/card/'), label: '名片', icon: 'identification-card', external: false },
  { href: withBase('/friends/'), label: '友链', icon: 'users', external: false },
  { href: withBase('/rss.xml'), label: 'RSS 订阅', icon: 'rss', external: false },
] as const;
---

<Base title="关于" description={`${AUTHOR.name}，${AUTHOR.intro}`}>
  <PageHeader title="关于" description={`${AUTHOR.name}，${AUTHOR.role}。${AUTHOR.intro}`} />

  <div class="container-page">
    {
      banner && (
        <figure class:list={['banner', { local: banner.local }]} data-reveal>
          <Image src={banner.src} alt={banner.alt} width={1600} class="h-full w-full object-cover" />
        </figure>
      )
    }

    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,42rem)_minmax(0,1fr)] lg:gap-16">
      <div class="about-text">
        <p>嗨，你好吗？我是青空，一个AI专业的在读本科生，感谢你读我的博客。</p>
        <p>
          我目前将我极大的心力用于研究AI RP领域，我着迷于将记忆，地理，时空与人格融合，让角色不再是传统的chatbox，而是一个可以不断在两次信息重建中延续的“个体”。
        </p>
        <p>这个站点本身也是一个项目，我希望能分享我在各方各面的感受和经验，结交一些志同道合的朋友，希望我的文章能帮助到你。</p>
        <p>
          对了，你听说过蝉与蟋蟀的故事吗？白皑皑的积雪中终有消散的一天，但歌声会一直流转下去，让我们保持对技术的尊敬与热情，除此之外也过好生活中的每一天吧！
        </p>

        <h2>联系</h2>
        <ul class="links">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="card card-link link-card"
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  <Icon name={link.icon} size={18} class="text-fg-muted" />
                  <span class="text-fg">{link.label}</span>
                  <Icon name={link.external ? 'arrow-up-right' : 'arrow-right'} size={14} class="ml-auto text-fg-subtle" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside>
        <div class="card facts">
          <p class="text-sm font-medium text-fg">现在</p>
          <dl class="mt-3 space-y-2.5">
            {
              facts.map((f) => (
                <div class="flex items-baseline justify-between gap-4 text-sm">
                  <dt class="text-fg-muted">{f.label}</dt>
                  <dd class="tabular text-fg">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <div class="mt-5 border-t border-line pt-4">
            <p class="text-sm font-medium text-fg">关注方向</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {AUTHOR.focus.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .banner {
    aspect-ratio: 21 / 8;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  /* 本机那张是白底插画，人物在画面中间。21:9 刚好把五个人从头发到鞋子都框进来。 */
  .banner.local {
    aspect-ratio: 21 / 9;
    background: #fff;
  }
  @media (width < 40rem) {
    .banner {
      aspect-ratio: 16 / 9;
    }
  }
  .about-text p {
    font-size: 1.0625rem;
    line-height: 1.9;
    color: var(--fg);
  }
  .about-text p + p {
    margin-top: 1.1em;
  }
  .about-text h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--fg);
  }
  .links {
    display: grid;
    gap: 0.75rem;
  }
  @media (width >= 40rem) {
    .links {
      grid-template-columns: 1fr 1fr;
    }
  }
  .link-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    font-size: 0.9375rem;
  }
  .facts {
    padding: 1.25rem;
  }
  @media (width >= 64rem) {
    .facts {
      position: sticky;
      top: calc(var(--nav-h) + 1.5rem);
    }
  }
</style>
