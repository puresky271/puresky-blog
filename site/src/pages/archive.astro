---
/**
 * 归档：按年、月分组的时间线。版式参考 innei.in/timeline。
 * 月份容器保留 id="YYYY-MM"：首页日历点一天多篇的日子会跳到 /archive/#YYYY-MM。
 */
import ArchiveTimeline from '@/components/archive/ArchiveTimeline.astro';
import Base from '@/layouts/Base.astro';
import { buildArchive } from '@/lib/archive';
import { getPosts } from '@/lib/content';

const archive = buildArchive(await getPosts());
---

<Base title="归档" description="全部文章，按时间排列。">
  <ArchiveTimeline archive={archive} />
</Base>
