---
// 正文由 Markdown 渲染，元素上没有作用域属性，排版样式必须全局引入。
import '@/styles/prose.css';

import { Image } from 'astro:assets';
import { render } from 'astro:content';

import Lightbox from '@/components/Lightbox.astro';
import Comments from '@/components/post/Comments.svelte';
import LikeButton from '@/components/post/LikeButton.svelte';
import PaperLangToggle from '@/components/post/PaperLangToggle.astro';
import PostEnhance from '@/components/post/PostEnhance.astro';
import ReadingPrefs from '@/components/post/ReadingPrefs.astro';
import Toc from '@/components/post/Toc.astro';
import ViewCount from '@/components/post/ViewCount.svelte';
import CategoryIcon from '@/components/ui/CategoryIcon.astro';
import Icon from '@/components/ui/Icon.astro';
import { AUTHOR, GITHUB } from '@/config';
import { questionOf } from '@/lib/leetcode';
import Base from '@/layouts/Base.astro';
import {
  categoryOf,
  subcategoryOf,
  getAdjacent,
  getAllPosts,
  getRelated,
  getSeries,
  postMinutes,
  postWords,
  type Post,
} from '@/lib/content';
import { categoryPath, formatDate, postPath, subcategoryPath, tagPath } from '@/lib/format';

export async function getStaticPaths() {
  // 归档的文章也生成页面：它们不进任何列表，但原链接要继续有效。
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// 目录只收 h2 / h3，少于两个时 Toc.astro 什么也不渲染：按没有目录处理，整页版心居中。
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3).length;
const noToc = tocItems < 2;

// 正文里有行首的 :::bi 才是中英对照文章，头部才需要原文语言开关。
const bilingual = /^ {0,3}:::bi\s*$/m.test(post.body ?? '');
const { title, description, pubDate, updatedDate, category, subcategory, leetcodeSlug, tags, cover, coverAlt, mayBeStale, commentsOff, archived } = post.data;

const [adjacent, series, related] = await Promise.all([getAdjacent(post), getSeries(post), getRelated(post)]);
const cat = categoryOf(category);
const sub = subcategoryOf(subcategory);
// 精选收录和论文解读是外部文章，作者一栏写原作者；站内文章才是博主自己。
const external = category === 'curation' || category === 'papers';
const byline = post.data.author ?? AUTHOR.name;
const bylineLabel = external ? '原文作者' : '作者';
const words = postWords(post);
const minutes = postMinutes(post);
const leetcode = leetcodeSlug ? questionOf(leetcodeSlug) : undefined;
const sourcePath = `${GITHUB.contentPath}/${post.filePath?.split('/').pop() ?? `${post.id}.mdx`}`;
const sourceUrl = `https://github.com/${GITHUB.repo}/blob/${GITHUB.branch}/${sourcePath}`;
const historyUrl = `https://github.com/${GITHUB.repo}/commits/${GITHUB.branch}/${sourcePath}`;
---

<Base title={title} description={description} type="article" publishedTime={pubDate} image={cover?.src}>
  <div class="reading-progress" aria-hidden="true"></div>

  <article class:list={['container-page', 'post-container', { 'no-toc': noToc }]}>
    <header class="post-header">
      <div class="post-hero">
        <div class="post-icon">
          <CategoryIcon category={category} />
        </div>
        <h1 class="post-title">{title}</h1>
        <div class="post-toolbar">
          {
            tags.length > 0 && (
              <ul class="post-tags" aria-label="标签">
                {tags.map((tag) => (
                  <li>
                    <a href={tagPath(tag)} class="tag-pill">
                      #{tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          <div class="prefs-row">
            {bilingual && <PaperLangToggle />}
            <ReadingPrefs />
          </div>
        </div>
        <p class="post-lead">{description}</p>
        <dl class="post-facts">
          <div class="fact">
            <dt>{bylineLabel}</dt>
            <dd>{byline}</dd>
          </div>
          <div class="fact">
            <dt>分类</dt>
            <dd>
              <a href={categoryPath(category)}>{cat.label}</a>
              <span class="fact-sep" aria-hidden="true">/</span>
              <a href={subcategoryPath(category, subcategory)}>{sub.label}</a>
            </dd>
          </div>
          <div class="fact">
            <dt>发布</dt>
            <dd>
              <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
              {updatedDate && <span class="fact-extra">更新于 {formatDate(updatedDate)}</span>}
            </dd>
          </div>
          <div class="fact">
            <dt>阅读</dt>
            <dd>约 {minutes} 分钟 · {words.toLocaleString('zh-CN')} 字</dd>
          </div>
        </dl>
        {
          cover && (
            <figure class="post-cover" data-zoom>
              <Image src={cover} alt={coverAlt ?? ''} width={1280} loading="eager" fetchpriority="high" class="h-auto w-full" />
            </figure>
          )
        }
      </div>
    </header>

    <div class="post-divider" aria-hidden="true"></div>

    <div class="post-grid">
      {
        !noToc && (
          <aside class="post-aside" aria-label="目录">
            <Toc headings={headings} variant="sidebar" />
          </aside>
        )
      }

      <div class="post-main">
        {
          !noToc && (
            <div class="lg:hidden">
              <Toc headings={headings} variant="inline" />
            </div>
          )
        }

        {
          archived && (
            <aside class="stale archived" role="note">
              <Icon name="archive" size={17} />
              <p>这篇文章已经归档，不再出现在文章列表和搜索里。内容保留在这里供参考，不再更新。</p>
            </aside>
          )
        }

        {
          mayBeStale && (
            <aside class="stale" role="note">
              <Icon name="hourglass-medium" size={17} />
              <p>这篇文章的结论可能已经过时。写作时的环境和依赖版本与现在不同，参考时请留意。</p>
            </aside>
          )
        }

        {
          leetcodeSlug && (
            <aside class="stale" role="note">
              <Icon name="code" size={17} />
              <p>这篇文章关联力扣题目 <a class="link" href={`https://leetcode.cn/problems/${leetcodeSlug}/`} target="_blank" rel="noopener noreferrer">{leetcode?.titleCn ?? leetcodeSlug}</a>{leetcode ? `（${leetcode.frontendId} · ${leetcode.difficulty} · ${leetcode.acRate == null ? '暂无通过率' : `${leetcode.acRate.toFixed(1)}% 通过率`}）` : ''}。代码风格因人而异，文中的题解代码以力扣官方题解为准。</p>
            </aside>
          )
        }

        {
          series.length > 1 && (
            <nav class="series" aria-label={`系列：${post.data.series}`}>
              <p class="text-[0.8125rem] text-fg-muted">
                系列 <span class="font-medium text-fg">{post.data.series}</span> · 共 {series.length} 篇
              </p>
              <ol class="mt-2 space-y-1">
                {series.map((item, i) => (
                  <li>
                    {item.id === post.id ? (
                      <span class="series-item current" aria-current="page">
                        <span class="tabular">{i + 1}.</span> {item.data.title}
                      </span>
                    ) : (
                      <a href={postPath(item.id)} class="series-item">
                        <span class="tabular">{i + 1}.</span> {item.data.title}
                      </a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        {/* 归档的文章不进站内搜索：没有 data-pagefind-body 的页面 pagefind 不收录。 */}
        <div class="prose mt-8" data-pagefind-body={archived ? undefined : ''}>
          <Content />
        </div>

        <footer class="post-footer">
          <div class="actions">
            <LikeButton client:visible slug={post.id} />
            <ViewCount client:idle slug={post.id} />
            <button type="button" class="btn btn-ghost" data-share>
              <Icon name="share-network" size={17} />
              <span data-share-label>分享</span>
            </button>
            <div class="source">
              {
                // 只在本机 astro dev 下出现：直接跳进本地编辑器改这一篇。
                import.meta.env.DEV && (
                  <a href={`/__editor/?post=${post.id}`}>
                    <Icon name="pencil-simple" size={15} />在编辑器中打开
                  </a>
                )
              }
              <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="code" size={15} />源文件
              </a>
              <a href={historyUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="clock-counter-clockwise" size={15} />修改历史
              </a>
            </div>
          </div>

          {
            (adjacent.newer || adjacent.older) && (
              <nav class="adjacent" aria-label="相邻文章">
                {adjacent.older ? (
                  <a href={postPath(adjacent.older.id)} class="card card-link adj">
                    <span class="meta inline-flex items-center gap-1">
                      <Icon name="arrow-left" size={13} />
                      上一篇
                    </span>
                    <span class="adj-title">{adjacent.older.data.title}</span>
                  </a>
                ) : (
                  <span />
                )}
                {adjacent.newer && (
                  <a href={postPath(adjacent.newer.id)} class="card card-link adj text-right">
                    <span class="meta inline-flex items-center justify-end gap-1">
                      下一篇
                      <Icon name="arrow-right" size={13} />
                    </span>
                    <span class="adj-title">{adjacent.newer.data.title}</span>
                  </a>
                )}
              </nav>
            )
          }

          {
            related.length > 0 && (
              <section aria-labelledby="related-title">
                <h2 id="related-title" class="text-base font-semibold text-fg">相关文章</h2>
                <ul class="mt-3 space-y-1">
                  {related.map((item) => (
                    <li>
                      <a href={postPath(item.id)} class="related">
                        <span>{item.data.title}</span>
                        <span class="meta shrink-0">{categoryOf(item.data.category).label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {!commentsOff && <Comments client:visible slug={post.id} />}
        </footer>
      </div>
    </div>
  </article>

  <PostEnhance />
  <Lightbox />
</Base>

<style>
  /* 阅读进度：滚动驱动动画，不监听 scroll 事件。不支持的浏览器上不显示。 */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: calc(var(--z-nav) + 1);
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .reading-progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  /*
   * 版式：文章页的版心比全站宽（1320px）。hero 与正文栏对齐，桌面端左侧留出目录栏的宽度；
   * 一条分隔线横跨整页，目录卡片只在分隔线下方出现并粘住。
   */
  .post-container {
    max-width: 1320px;
  }
  .post-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: center;
    padding-top: 1.75rem;
  }
  .post-hero {
    grid-column: 1;
    min-width: 0;
  }
  @media (width >= 48rem) {
    .post-header {
      padding-top: 2.5rem;
    }
  }
  @media (width >= 64rem) {
    /* 桌面端 hero 与正文栏对齐，左边留出目录栏的宽度。正文栏 46rem，整块落在版心偏右的位置，
       和参考站一样看起来是居中的一栏。 */
    .post-header {
      grid-template-columns: 18rem minmax(0, 46rem);
      justify-content: start;
      column-gap: 2.5rem;
    }
    .post-hero {
      grid-column: 2;
    }
  }
  @media (width >= 80rem) {
    .post-header {
      grid-template-columns: 20rem minmax(0, 46rem);
      column-gap: 3.5rem;
    }
  }
  @media (width >= 64rem) {
    .post-container.no-toc .post-header {
      grid-template-columns: minmax(0, 46rem);
      justify-content: center;
    }
    .post-container.no-toc .post-hero {
      grid-column: 1;
    }
  }

  /* 分隔线铺满整个视口，hero 收在线上，目录从线下面才开始。 */
  .post-divider {
    position: relative;
    height: 1px;
    margin-top: 2.5rem;
    background: var(--line);
  }
  .post-divider::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    translate: -50% 0;
    background: var(--line);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 58rem);
    justify-content: center;
    column-gap: 3rem;
    padding-top: 2.5rem;
  }
  @media (width >= 64rem) {
    .post-grid {
      grid-template-columns: 18rem minmax(0, 46rem);
      justify-content: start;
      column-gap: 2.5rem;
    }
  }
  @media (width >= 80rem) {
    .post-grid {
      grid-template-columns: 20rem minmax(0, 46rem);
      column-gap: 3.5rem;
    }
  }
  @media (width >= 64rem) {
    .post-container.no-toc .post-grid {
      grid-template-columns: minmax(0, 46rem);
      justify-content: center;
    }
  }
  .post-aside {
    display: none;
  }
  @media (width >= 64rem) {
    .post-aside {
      display: block;
    }
  }

  /* 题材图标和标题同一栏，图标在上。 */
  .post-icon {
    width: fit-content;
    margin-bottom: 1.35rem;
  }
  .post-title {
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.6rem);
    line-height: 1.28;
    font-weight: 750;
    letter-spacing: -0.025em;
    color: var(--fg);
    text-wrap: balance;
  }
  /* 导语用衬线体，和无衬线的正文拉开层次。 */
  .post-lead {
    margin-top: 0.9rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.75;
    color: color-mix(in oklab, var(--fg) 78%, var(--fg-muted));
  }

  /* 事实栏：作者 / 分类 / 发布 / 阅读。标签用等宽小字，值前面挂一个 └。 */
  /*
   * 事实栏：默认两列（作者 / 分类、发布 / 阅读），窄屏时阅读那一项占满整行，避免“约 15 分钟 ·
   * 5,580 字”被折成两行；桌面版心够宽时才排成四列，阅读列给得宽一些。
   */
  .post-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 1.5rem;
    margin-top: 1.9rem;
    font-family: var(--font-mono);
  }
  @media (width >= 80rem) {
    .post-facts {
      grid-template-columns: 1.15fr 1.4fr 1fr 1.25fr;
    }
  }
  @media (width < 48rem) {
    .post-facts .fact:last-child {
      grid-column: 1 / -1;
    }
  }
  .post-facts .fact {
    min-width: 0;
  }
  .post-facts dt {
    margin-bottom: 0.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
  }
  .post-facts dd {
    margin: 0;
    padding-left: 1.15em;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--fg);
    text-indent: -1.15em;
    overflow-wrap: anywhere;
  }
  /* 日期和“约 15 分钟 · 5,580 字”这类短内容不折行。 */
  .post-facts time {
    white-space: nowrap;
  }
  .post-facts dd::before {
    content: '└';
    display: inline-block;
    width: 1.15em;
    font-family: var(--font-mono);
    color: var(--fg-subtle);
    text-indent: 0;
  }
  .post-facts a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--fg) 24%, transparent);
    text-underline-offset: 0.18em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }
  .post-facts a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .post-facts .fact-sep {
    margin-inline: 0.3rem;
    color: var(--fg-subtle);
  }
  .post-facts .fact-extra {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--fg-subtle);
  }
  @media (width < 22rem) {
    .post-facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
    }
    .post-facts .fact:last-child {
      grid-column: auto;
    }
  }

  /*
   * 标签和选项按钮（原文语言、正文字体字号）排标题下面：标签占左边，太多时折成两排；
   * 开关靠右并对齐到标签最后一排，不单独占一行。
   */
  .post-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
  }
  .prefs-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-left: auto;
  }
  .prefs-row :global(.reading-prefs) {
    margin-left: 0;
  }

  .post-tags {
    display: flex;
    flex: 1 1 16rem;
    flex-wrap: wrap;
    min-width: 0;
    gap: 0.45rem;
  }
  .tag-pill {
    display: inline-flex;
    align-items: center;
    height: 1.7rem;
    padding-inline: 0.65rem;
    border-radius: 8px;
    border: 1px solid var(--line-strong);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .tag-pill:hover {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--line));
    background: color-mix(in oklab, var(--accent) 6%, transparent);
  }
  .post-cover {
    margin-top: 2rem;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
  }
  .post-main {
    margin-top: 0;
  }

  .stale {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-control);
    border: 1px solid color-mix(in oklab, var(--warning) 35%, var(--line));
    background: color-mix(in oklab, var(--warning) 8%, var(--surface));
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--fg);
  }
  .stale :global(svg) {
    margin-top: 0.15rem;
    color: var(--warning);
  }
  .stale.archived {
    border-color: var(--line-strong);
    background: var(--surface-2);
    color: var(--fg-muted);
  }
  .stale.archived :global(svg) {
    color: var(--fg-subtle);
  }

  .series {
    margin-top: 1.5rem;
    padding: 1rem 1.15rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .series-item {
    display: block;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  a.series-item:hover {
    color: var(--accent);
  }
  .series-item.current {
    color: var(--fg);
    font-weight: 600;
  }

  .post-footer {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .source {
    display: flex;
    gap: 1rem;
    margin-left: auto;
    font-size: 0.8125rem;
  }
  .source a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--fg-muted);
    transition: color 160ms ease;
  }
  .source a:hover {
    color: var(--fg);
  }
  @media (width < 30rem) {
    .source {
      margin-left: 0;
      width: 100%;
    }
  }

  .adjacent {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 40rem) {
    .adjacent {
      grid-template-columns: 1fr 1fr;
    }
  }
  .adj {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
  }
  .adj-title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--fg);
  }
  .related {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    font-size: 0.9375rem;
    color: var(--fg);
  }
  .related:hover span:first-child {
    color: var(--accent);
  }
</style>
