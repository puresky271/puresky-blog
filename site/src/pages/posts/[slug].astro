---
// 正文由 Markdown 渲染，元素上没有作用域属性，排版样式必须全局引入。
import '@/styles/prose.css';

import { Image } from 'astro:assets';
import { render } from 'astro:content';

import Lightbox from '@/components/Lightbox.astro';
import Comments from '@/components/post/Comments.svelte';
import LikeButton from '@/components/post/LikeButton.svelte';
import PostEnhance from '@/components/post/PostEnhance.astro';
import Toc from '@/components/post/Toc.astro';
import ViewCount from '@/components/post/ViewCount.svelte';
import Icon from '@/components/ui/Icon.astro';
import { GITHUB } from '@/config';
import Base from '@/layouts/Base.astro';
import {
  categoryOf,
  getAdjacent,
  getAllPosts,
  getRelated,
  getSeries,
  postMinutes,
  postWords,
  type Post,
} from '@/lib/content';
import { categoryPath, formatDate, postPath, tagPath } from '@/lib/format';

export async function getStaticPaths() {
  // 归档的文章也生成页面：它们不进任何列表，但原链接要继续有效。
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, category, tags, cover, coverAlt, mayBeStale, commentsOff, archived } = post.data;

const [adjacent, series, related] = await Promise.all([getAdjacent(post), getSeries(post), getRelated(post)]);
const cat = categoryOf(category);
const sourcePath = `${GITHUB.contentPath}/${post.filePath?.split('/').pop() ?? `${post.id}.mdx`}`;
const sourceUrl = `https://github.com/${GITHUB.repo}/blob/${GITHUB.branch}/${sourcePath}`;
const historyUrl = `https://github.com/${GITHUB.repo}/commits/${GITHUB.branch}/${sourcePath}`;
---

<Base title={title} description={description} type="article" publishedTime={pubDate} image={cover?.src}>
  <div class="reading-progress" aria-hidden="true"></div>

  <article class="container-page post-container">
    <div class="post-grid">
      <header class="post-header">
        <p class="post-meta">
          <a href={categoryPath(category)} class="cat">{cat.label}</a>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <ViewCount client:idle slug={post.id} />
          <span aria-hidden="true">·</span>
          <span class="tabular">{postWords(post).toLocaleString('zh-CN')} 字</span>
          <span aria-hidden="true">·</span>
          <span>约 {postMinutes(post)} 分钟</span>
          {
            updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <em class="updated">更新于 {formatDate(updatedDate)}</em>
              </>
            )
          }
        </p>
        <h1 class="post-title">{title}</h1>
        <p class="post-lead">{description}</p>
        {
          tags.length > 0 && (
            <ul class="post-tags" aria-label="标签">
              {tags.map((tag) => (
                <li>
                  <a href={tagPath(tag)} class="tag-pill">
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {
          cover && (
            <figure class="post-cover" data-zoom>
              <Image src={cover} alt={coverAlt ?? ''} width={1280} loading="eager" fetchpriority="high" class="h-auto w-full" />
            </figure>
          )
        }
      </header>

      <aside class="post-aside" aria-label="目录">
        <Toc headings={headings} variant="sidebar" />
      </aside>

      <div class="post-main">
        <div class="lg:hidden">
          <Toc headings={headings} variant="inline" />
        </div>

        {
          archived && (
            <aside class="stale archived" role="note">
              <Icon name="archive" size={17} />
              <p>这篇文章已经归档，不再出现在文章列表和搜索里。内容保留在这里供参考，不再更新。</p>
            </aside>
          )
        }

        {
          mayBeStale && (
            <aside class="stale" role="note">
              <Icon name="hourglass-medium" size={17} />
              <p>这篇文章的结论可能已经过时。写作时的环境和依赖版本与现在不同，参考时请留意。</p>
            </aside>
          )
        }

        {
          series.length > 1 && (
            <nav class="series" aria-label={`系列：${post.data.series}`}>
              <p class="text-[0.8125rem] text-fg-muted">
                系列 <span class="font-medium text-fg">{post.data.series}</span> · 共 {series.length} 篇
              </p>
              <ol class="mt-2 space-y-1">
                {series.map((item, i) => (
                  <li>
                    {item.id === post.id ? (
                      <span class="series-item current" aria-current="page">
                        <span class="tabular">{i + 1}.</span> {item.data.title}
                      </span>
                    ) : (
                      <a href={postPath(item.id)} class="series-item">
                        <span class="tabular">{i + 1}.</span> {item.data.title}
                      </a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        {/* 归档的文章不进站内搜索：没有 data-pagefind-body 的页面 pagefind 不收录。 */}
        <div class="prose mt-8" data-pagefind-body={archived ? undefined : ''}>
          <Content />
        </div>

        <footer class="post-footer">
          <div class="actions">
            <LikeButton client:visible slug={post.id} />
            <button type="button" class="btn btn-ghost" data-share>
              <Icon name="share-network" size={17} />
              <span data-share-label>分享</span>
            </button>
            <div class="source">
              {
                // 只在本机 astro dev 下出现：直接跳进本地编辑器改这一篇。
                import.meta.env.DEV && (
                  <a href={`/__editor/?post=${post.id}`}>
                    <Icon name="pencil-simple" size={15} />在编辑器中打开
                  </a>
                )
              }
              <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="code" size={15} />源文件
              </a>
              <a href={historyUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="clock-counter-clockwise" size={15} />修改历史
              </a>
            </div>
          </div>

          {
            (adjacent.newer || adjacent.older) && (
              <nav class="adjacent" aria-label="相邻文章">
                {adjacent.older ? (
                  <a href={postPath(adjacent.older.id)} class="card card-link adj">
                    <span class="meta inline-flex items-center gap-1">
                      <Icon name="arrow-left" size={13} />
                      上一篇
                    </span>
                    <span class="adj-title">{adjacent.older.data.title}</span>
                  </a>
                ) : (
                  <span />
                )}
                {adjacent.newer && (
                  <a href={postPath(adjacent.newer.id)} class="card card-link adj text-right">
                    <span class="meta inline-flex items-center justify-end gap-1">
                      下一篇
                      <Icon name="arrow-right" size={13} />
                    </span>
                    <span class="adj-title">{adjacent.newer.data.title}</span>
                  </a>
                )}
              </nav>
            )
          }

          {
            related.length > 0 && (
              <section aria-labelledby="related-title">
                <h2 id="related-title" class="text-base font-semibold text-fg">相关文章</h2>
                <ul class="mt-3 space-y-1">
                  {related.map((item) => (
                    <li>
                      <a href={postPath(item.id)} class="related">
                        <span>{item.data.title}</span>
                        <span class="meta shrink-0">{categoryOf(item.data.category).label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {!commentsOff && <Comments client:visible slug={post.id} />}
        </footer>
      </div>
    </div>
  </article>

  <PostEnhance />
  <Lightbox />
</Base>

<style>
  /* 阅读进度：滚动驱动动画，不监听 scroll 事件。不支持的浏览器上不显示。 */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: calc(var(--z-nav) + 1);
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .reading-progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  /*
   * 版式：文章页的版心比全站宽（1320px）。桌面端左边是目录卡片（17rem），右边是正文（58rem，约 928px）；
   * 头部在正文那一栏上方，目录卡片从页面顶部开始粘住。
   */
  .post-container {
    max-width: 1320px;
  }
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 58rem);
    justify-content: center;
    column-gap: 3rem;
  }
  @media (width >= 64rem) {
    .post-grid {
      grid-template-columns: 17rem minmax(0, 58rem);
      grid-template-areas:
        'aside header'
        'aside main';
    }
    .post-header {
      grid-area: header;
    }
    .post-main {
      grid-area: main;
    }
    .post-aside {
      grid-area: aside;
    }
  }
  .post-aside {
    display: none;
  }
  @media (width >= 64rem) {
    .post-aside {
      display: block;
    }
  }

  .post-header {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.55rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
  .post-meta .cat {
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    padding-inline: 0.6rem;
    margin-right: 0.15rem;
    border-radius: 999px;
    font-weight: 500;
    color: var(--accent-strong);
    background: var(--accent-soft);
    transition: background-color 160ms ease;
  }
  .post-meta .cat:hover {
    background: color-mix(in oklab, var(--accent) 18%, var(--accent-soft));
  }
  .post-meta .updated {
    font-style: italic;
  }
  .post-title {
    margin-top: 0.9rem;
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.6rem);
    line-height: 1.28;
    font-weight: 750;
    letter-spacing: -0.025em;
    color: var(--fg);
    text-wrap: balance;
  }
  /* 导语用衬线体，和无衬线的正文拉开层次。 */
  .post-lead {
    margin-top: 0.9rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.75;
    color: color-mix(in oklab, var(--fg) 78%, var(--fg-muted));
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.25rem;
  }
  .tag-pill {
    display: inline-flex;
    align-items: center;
    height: 1.7rem;
    padding-inline: 0.65rem;
    border-radius: 8px;
    border: 1px solid var(--line-strong);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .tag-pill:hover {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--line));
    background: color-mix(in oklab, var(--accent) 6%, transparent);
  }
  .post-cover {
    margin-top: 2rem;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
  }
  .post-main {
    margin-top: 0.5rem;
  }

  .stale {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-control);
    border: 1px solid color-mix(in oklab, var(--warning) 35%, var(--line));
    background: color-mix(in oklab, var(--warning) 8%, var(--surface));
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--fg);
  }
  .stale :global(svg) {
    margin-top: 0.15rem;
    color: var(--warning);
  }
  .stale.archived {
    border-color: var(--line-strong);
    background: var(--surface-2);
    color: var(--fg-muted);
  }
  .stale.archived :global(svg) {
    color: var(--fg-subtle);
  }

  .series {
    margin-top: 1.5rem;
    padding: 1rem 1.15rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .series-item {
    display: block;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  a.series-item:hover {
    color: var(--accent);
  }
  .series-item.current {
    color: var(--fg);
    font-weight: 600;
  }

  .post-footer {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .source {
    display: flex;
    gap: 1rem;
    margin-left: auto;
    font-size: 0.8125rem;
  }
  .source a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--fg-muted);
    transition: color 160ms ease;
  }
  .source a:hover {
    color: var(--fg);
  }
  @media (width < 30rem) {
    .source {
      margin-left: 0;
      width: 100%;
    }
  }

  .adjacent {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 40rem) {
    .adjacent {
      grid-template-columns: 1fr 1fr;
    }
  }
  .adj {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
  }
  .adj-title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--fg);
  }
  .related {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    font-size: 0.9375rem;
    color: var(--fg);
  }
  .related:hover span:first-child {
    color: var(--accent);
  }
</style>
