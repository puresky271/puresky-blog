---
import PostListing from '@/components/post/PostListing.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Base from '@/layouts/Base.astro';
import { getPosts, getTags, type Post } from '@/lib/content';
import { withBase } from '@/lib/format';

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([getPosts(), getTags()]);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`标签「${tag}」下的 ${posts.length} 篇文章。`}>
  <PageHeader title={`#${tag}`} count={posts.length}>
    <p class="mt-3 text-sm text-fg-muted">
      <a href={withBase('/tags/')} class="link">全部标签</a>
    </p>
  </PageHeader>
  <PostListing posts={posts} />
</Base>
